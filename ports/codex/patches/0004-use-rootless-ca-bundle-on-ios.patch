+/// Uses the Procursus CA bundle when iOS does not expose it through the native root store.
+///
+/// Rootless jailbreak packages install their TLS roots below `/var/jb`. Explicit Codex and
+/// OpenSSL-compatible environment overrides retain precedence over this platform default.
+fn ios_rootless_ca_bundle() -> Option<ConfiguredCaBundle> {
+    #[cfg(target_os = "ios")]
+    {
+        let path = PathBuf::from(IOS_ROOTLESS_CA_PATH);
+        return path.is_file().then_some(ConfiguredCaBundle {
+            source_env: IOS_ROOTLESS_CA_SOURCE,
+            path,
+        });
+    }
+
+    #[cfg(not(target_os = "ios"))]
+    None
+}
