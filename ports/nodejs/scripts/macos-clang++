#!/bin/bash
set -euo pipefail

sdk_root=$(xcrun --sdk macosx --show-sdk-path)

args=()
linking=1
for arg in "$@"; do
  case "$arg" in
    -Wl,--start-group|-Wl,--end-group)
      continue
      ;;
    -c)
      linking=0
      ;;
  esac
  args+=("$arg")
done

if [[ "$linking" == "1" ]]; then
  args+=(-framework CoreFoundation)
fi

exec xcrun --sdk macosx clang++ \
  -isysroot "$sdk_root" \
  -std=gnu++20 \
  "${args[@]}"
